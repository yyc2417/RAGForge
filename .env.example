# ── DeepSeek API（必填）─────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_TIMEOUT=60
# 拼 prompt 的检索文档 token 上限（超限按检索分从高到低截断，至少保留 1 篇）
CONTEXT_TOKEN_BUDGET=3000

# ── Embedding ───────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# 换型预留（BGE 等）：按模型卡决定是否开启
EMBEDDING_NORMALIZE=false
EMBEDDING_QUERY_INSTRUCTION=
EMBEDDING_TRUST_REMOTE_CODE=false

# ── ChromaDB ────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=knowledge_base
EVAL_CHROMA_PERSIST_DIR=./chroma_db_eval
EVAL_CHROMA_COLLECTION_NAME=knowledge_base_eval

# ── 数据路径 ────────────────────────────────────────────────────
DATA_DIR=data/sample
DEMO_DIR=data/demo
LIBRARY_DIR=data/library
EVAL_DATA_DIR=data/sample
SESSION_DIR=data/sessions
FEEDBACK_DIR=data/feedback
MAX_IMPORT_FILES=50
MAX_UPLOAD_MB=20

# ── 会话与澄清 ──────────────────────────────────────────────────
CONVERSATION_HISTORY_TURNS=6
CONVERSATION_TOKEN_BUDGET=1200
CLARIFY_ENABLED=true

# ── 切分参数（单位：token，cl100k 估算；需小于 embedding 模型窗口）──
CHUNK_SIZE=220
CHUNK_OVERLAP=30
RETRIEVAL_K=3

# ── 混合检索 + Reranker ────────────────────────────────────────
RRF_K=60
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=5

# ── 优质库加权通道 ─────────────────────────────────────────────
QUALITY_WEIGHT=1.3
QUALITY_TOP_K=3
QUALITY_MIN_RELEVANCE=0.3
QUALITY_MAX_PER_SOURCE=2

# ── API 服务 ───────────────────────────────────────────────────
# 默认仅监听本机；对外部署时改为 0.0.0.0 并配合鉴权
API_HOST=127.0.0.1
API_PORT=8000
# CORS 白名单（JSON 数组格式）
API_CORS_ORIGINS=["*"]

# ── LangSmith 追踪（可选，填入 key 并置 true 即启用）─────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ragforge
LANGSMITH_TRACING=false
